{
  "version": 1,
  "state_dir": ".apee",
  "codex": "codex",
  "agent_timeout_seconds": 900,
  "command_timeout_seconds": 300,
  "max_tasks_per_cycle": 1,
  "daily_attempt_limit": 10,
  "max_pr_checks_per_cycle": 20,
  "auto_recovery": {
    "enabled": false,
    "max_retries": 1,
    "cooldown_seconds": 300,
    "max_per_cycle": 1
  },
  "budget": {},
  "quality": {"enabled": true, "max_repairs": 1},
  "ci_repair": {"enabled": true, "max_attempts_per_pr": 1},
  "planning": {"enabled": false, "max_active_projects": 2, "max_new_tasks_per_cycle": 1, "max_pending_candidates": 5, "max_calls_per_day": 1},
  "notifications": {"enabled": false, "max_attempts": 6},
  "projects": [
    {
      "repo": "your-account/your-project",
      "enabled": false,
      "priority": 1,
      "issue_label": "apee:ready",
      "setup": [["npm", "ci", "--ignore-scripts"]],
      "setup_network": true,
      "tests": [["npm", "test"]],
      "publish_draft": true
    }
  ]
}
